# --- Nexora local development environment ---
# Copy to .env and adjust. NEVER commit .env or real credentials.

# Runtime
NEXORA_ENV=development
NEXORA_HTTP_ADDR=:8080
NEXORA_LOG_LEVEL=info
NEXORA_SHUTDOWN_TIMEOUT=15s
# Automatic migrations are allowed in development only.
NEXORA_MIGRATE_ON_START=true

# PostgreSQL
NEXORA_DATABASE_URL=postgres://nexora:nexora_dev_password@localhost:5432/nexora?sslmode=disable
NEXORA_DB_MAX_CONNS=10
NEXORA_DB_MIN_CONNS=0
NEXORA_DB_CONNECT_TIMEOUT=10s
NEXORA_DB_MAX_CONN_LIFETIME=1h
NEXORA_DB_MAX_CONN_IDLE_TIME=30m

# Docker Compose (development defaults only)
NEXORA_POSTGRES_DB=nexora
NEXORA_POSTGRES_USER=nexora
NEXORA_POSTGRES_PASSWORD=nexora_dev_password
NEXORA_POSTGRES_PORT=5432
NEXORA_API_PORT=8080
NEXORA_WEB_PORT=3000

# Frontend (empty = same-origin / Vite proxy)
VITE_API_BASE_URL=
