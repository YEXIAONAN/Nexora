#!/usr/bin/env bash
# Nexora one-command development entry point.
#
#   ./start
#
# Starts PostgreSQL (Docker), applies reviewed migrations, starts the Go API and
# the Vite dev server, and prints the URLs. Re-running is safe: existing data is
# preserved and services already listening are reused instead of duplicated.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

RUN_DIR="$ROOT_DIR/.run"
API_LOG="$RUN_DIR/api.log"
WEB_LOG="$RUN_DIR/web.log"
mkdir -p "$RUN_DIR"

API_PID=""
WEB_PID=""
STARTED_API=0
STARTED_WEB=0

log() { printf '\033[36m◇\033[0m %s\n' "$*"; }
ok() { printf '\033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[33m!\033[0m %s\n' "$*"; }
fail() { printf '\033[31m✗\033[0m %s\n' "$*" >&2; }

cleanup() {
  local status=$?
  trap - EXIT INT TERM
  if [[ "$STARTED_API" == "1" && -n "$API_PID" ]]; then
    kill "$API_PID" 2>/dev/null || true
    wait "$API_PID" 2>/dev/null || true
    echo
    log "已停止 API 进程（日志：.run/api.log）"
  fi
  if [[ "$STARTED_WEB" == "1" && -n "$WEB_PID" ]]; then
    kill "$WEB_PID" 2>/dev/null || true
    wait "$WEB_PID" 2>/dev/null || true
    log "已停止前端进程（日志：.run/web.log）"
  fi
  if [[ "$STARTED_API" == "1" || "$STARTED_WEB" == "1" ]]; then
    log "PostgreSQL 容器保留运行，数据不会被清除。需要停止：docker compose stop postgres"
  fi
  exit "$status"
}
trap cleanup EXIT INT TERM

port_in_use() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

wait_for_http() {
  local url=$1
  local attempts=${2:-60}
  local i
  for ((i = 0; i < attempts; i++)); do
    if curl -fsS --max-time 2 "$url" >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  return 1
}

if [[ ! -f .env ]]; then
  cp .env.example .env
  warn "未找到 .env，已从 .env.example 创建。请按需修改数据库密码等配置。"
fi

set -a
# shellcheck disable=SC1091
source .env
set +a

API_PORT="${NEXORA_API_PORT:-8080}"
WEB_PORT="${NEXORA_WEB_PORT:-3000}"
API_ADDR="${NEXORA_HTTP_ADDR:-127.0.0.1:$API_PORT}"
# NEXORA_HTTP_ADDR may be ":8080"; derive a reachable health URL.
HEALTH_HOST="127.0.0.1"
HEALTH_URL="http://${HEALTH_HOST}:${API_PORT}/healthz"
WEB_URL="http://127.0.0.1:${WEB_PORT}"

echo
printf '\033[1mNexora\033[0m · 本地开发启动\n'
echo "────────────────────────────────────────"

# 1. PostgreSQL ---------------------------------------------------------------
if docker info >/dev/null 2>&1; then
  log "启动 PostgreSQL 容器…"
  docker compose up -d postgres >/dev/null
  for i in $(seq 1 45); do
    if docker compose exec -T postgres pg_isready -U "${NEXORA_POSTGRES_USER:-nexora}" -d "${NEXORA_POSTGRES_DB:-nexora}" >/dev/null 2>&1; then
      ok "PostgreSQL 已就绪"
      break
    fi
    if [[ "$i" == "45" ]]; then
      fail "PostgreSQL 启动超时，请检查 docker compose logs postgres"
      exit 1
    fi
    sleep 1
  done
else
  warn "Docker 不可用，假设已有 PostgreSQL 在 ${NEXORA_DATABASE_URL:-localhost:5432} 运行。"
fi

# 2. Migrations ---------------------------------------------------------------
log "检查并应用数据库迁移…"
if (cd apps/api && go run ./cmd/migrate -command up); then
  ok "数据库迁移已是最新"
else
  fail "数据库迁移失败，请检查上方错误信息。"
  exit 1
fi

# 3. Root account -------------------------------------------------------------
root_initialized="unknown"
root_username=""
if docker info >/dev/null 2>&1; then
  root_initialized="$(docker compose exec -T postgres psql -U "${NEXORA_POSTGRES_USER:-nexora}" -d "${NEXORA_POSTGRES_DB:-nexora}" -tAc "SELECT count(*) FROM users WHERE system_root" 2>/dev/null | tr -d '[:space:]' || true)"
  root_username="$(docker compose exec -T postgres psql -U "${NEXORA_POSTGRES_USER:-nexora}" -d "${NEXORA_POSTGRES_DB:-nexora}" -tAc "SELECT username FROM users WHERE system_root LIMIT 1" 2>/dev/null | tr -d '[:space:]' || true)"
fi

if [[ "$root_initialized" == "0" ]]; then
  warn "检测到尚未初始化 ROOT 管理员账号。"
  if [[ -t 0 ]]; then
    log "即将运行安全初始化流程（不会创建默认密码）。"
    if (cd apps/api && go run ./cmd/bootstrap -username "${NEXORA_ROOT_USERNAME:-admin}"); then
      ok "ROOT 管理员已创建"
      root_initialized="1"
      root_username="${NEXORA_ROOT_USERNAME:-admin}"
    else
      fail "ROOT 初始化失败。稍后可单独执行：make bootstrap"
      root_initialized="0"
    fi
  else
    warn "当前不是交互终端，跳过 ROOT 初始化。请运行：make bootstrap"
  fi
elif [[ "$root_initialized" =~ ^[0-9]+$ ]] && [[ "$root_initialized" -gt 0 ]]; then
  ok "管理员账号已存在，保留现有账号与密码"
else
  warn "无法直接读取账号状态；首次使用请运行 make bootstrap"
fi

# 4. API ----------------------------------------------------------------------
if curl -fsS --max-time 2 "$HEALTH_URL" >/dev/null 2>&1; then
  ok "API 已在 ${API_PORT} 端口运行，复用现有进程"
else
  if port_in_use "$API_PORT"; then
    fail "端口 ${API_PORT} 已被其他进程占用。请设置 NEXORA_API_PORT 或停止占用进程。"
    exit 1
  fi
  log "启动 Go API…"
  (cd apps/api && exec go run ./cmd/server) >"$API_LOG" 2>&1 &
  API_PID=$!
  STARTED_API=1
  if ! wait_for_http "$HEALTH_URL" 90; then
    fail "API 未能启动，最近日志："
    tail -30 "$API_LOG" >&2 || true
    exit 1
  fi
  ok "API 已就绪"
fi

# 5. Web ----------------------------------------------------------------------
if [[ ! -d apps/web/node_modules ]]; then
  log "安装前端依赖（仅首次）…"
  (cd apps/web && pnpm install --frozen-lockfile)
fi

if port_in_use "$WEB_PORT"; then
  if curl -fsS --max-time 2 "$WEB_URL" >/dev/null 2>&1; then
    ok "前端已在 ${WEB_PORT} 端口运行，复用现有服务"
  else
    fail "端口 ${WEB_PORT} 已被占用。请设置 NEXORA_WEB_PORT 或停止占用进程。"
    exit 1
  fi
else
  log "启动 Vite 前端…"
  (cd apps/web && exec pnpm exec vite --host 127.0.0.1 --port "$WEB_PORT") >"$WEB_LOG" 2>&1 &
  WEB_PID=$!
  STARTED_WEB=1
  if ! wait_for_http "$WEB_URL" 90; then
    fail "前端未能启动，最近日志："
    tail -30 "$WEB_LOG" >&2 || true
    exit 1
  fi
  ok "前端已就绪"
fi

# 6. Summary ------------------------------------------------------------------
registration="${NEXORA_REGISTRATION_MODE:-}"
if [[ -z "$registration" ]]; then
  if [[ "${NEXORA_ENV:-development}" == "production" ]]; then registration="invite"; else registration="open"; fi
fi
case "$registration" in
  open) reg_text="开放注册（可直接创建账号）" ;;
  invite) reg_text="邀请注册（需先被团队邀请）" ;;
  closed) reg_text="关闭自助注册（由管理员创建账号）" ;;
  *) reg_text="$registration" ;;
esac

echo "────────────────────────────────────────"
printf '\033[1;32mNexora 已启动\033[0m\n\n'
printf '  前端地址   \033[4m%s\033[0m\n' "$WEB_URL"
printf '  后端 API   http://127.0.0.1:%s\n' "$API_PORT"
printf '  运行模式   %s\n' "${NEXORA_ENV:-development}"
printf '  注册策略   %s\n' "$reg_text"
echo
if [[ "$root_initialized" == "0" ]]; then
  printf '  管理员     \033[33m尚未初始化\033[0m — 重新运行 ./start 或执行 make bootstrap\n'
else
  printf '  管理员     已初始化（用户名：%s），请使用你自己设置的密码登录\n' "${root_username:-${NEXORA_ROOT_USERNAME:-admin}}"
fi
echo
printf '  首次使用   打开前端 → 登录或注册 → 创建 Team → 创建 Project → 添加任务\n'
printf '  停止服务   \033[1mCtrl+C\033[0m（仅停止本次启动的 API 与前端）\n'
printf '  日志       .run/api.log · .run/web.log\n'
echo "────────────────────────────────────────"
echo

if [[ "$STARTED_API" == "1" || "$STARTED_WEB" == "1" ]]; then
  wait
else
  log "两个服务均由已有进程提供，无需保持本脚本运行。"
fi
